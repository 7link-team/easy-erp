{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "库存管理",
  "version": "0.1.3",
  "identifier": "com.aspeed.easy-erp",
  "build": {
    "frontendDist": "./ui",
    "beforeDevCommand": "node scripts/prepare-desktop.mjs --debug",
    "beforeBuildCommand": "node scripts/prepare-desktop.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "title": "库存管理 · 主机连接",
        "width": 640,
        "height": 660,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "languages": ["SimpChinese"],
        "installMode": "both",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": "all",
    "externalBin": ["binaries/easy-erp-server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
