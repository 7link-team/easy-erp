{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "launcher",
  "platforms": ["macOS", "windows", "linux"],
  "description": "Only the packaged connection window has native management access. Business windows have no native capabilities.",
  "windows": ["launcher"],
  "permissions": [
    "core:default",
    "allow-file-locations",
    "allow-reveal-file",
    "allow-recovery-list",
    "allow-recovery-select-backup",
    "allow-recovery-execute",
    "allow-connection-settings",
    "allow-set-autostart",
    "allow-connect-host",
    "allow-start-local",
    "allow-resume-last",
    "allow-show-launcher",
    "allow-close-data-maintenance",
    "allow-open-browser",
    "allow-update-info",
    "allow-check-update",
    "allow-set-update-channel",
    "allow-download-update",
    "allow-install-update"
  ]
}
